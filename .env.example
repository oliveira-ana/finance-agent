OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

DADOS_DIR=dados
FUSO=America/Sao_Paulo

# P01 - saque acima de X vezes a média dos últimos saques precisa de aprovador
SAQUE_MULTIPLICADOR_MEDIA=3
# P02 - quantidade de saques recentes usados na média
SAQUE_QTD_MEDIA=10
# P03 - estorno acima deste valor (R$) precisa de aprovador
ESTORNO_LIMITE=1000.00
# P04 - tentativas de PIN antes do bloqueio
PIN_TENTATIVAS=3
# P05 - minutos de bloqueio
PIN_BLOQUEIO_MIN=15
# P06 - período padrão do extrato (dias)
EXTRATO_DIAS_PADRAO=30
# P07 - mínimo de saques para usar a média
SAQUE_MIN_HISTORICO=3
# P08 - limite (R$) de saque sem aprovador para cliente sem histórico
SAQUE_LIMITE_SEM_HISTORICO=1000.00

MAX_TOOLS_POR_MENSAGEM=5
RETENCAO_SESSOES_DIAS=90
RETENCAO_AUDITORIA_ANOS=5
# Valor máximo por operação (R$)
VALOR_MAXIMO_OPERACAO=1000000.00
